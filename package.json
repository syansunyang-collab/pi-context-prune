{
  "name": "@syansunyang/pi-context-prune",
  "version": "1.5.2",
  "description": "Pi coding-agent extension that summarizes finished tool-call output out of context and keeps the originals one query away. Fork of championswimmer/pi-context-prune 1.4.0, with fixes for pruned-result handling, errored turns, reload and abort.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && esbuild index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --sourcemap --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui",
    "check": "npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package"
  },
  "keywords": [
    "pi-package",
    "context-pruning",
    "coding-agent",
    "llm",
    "context-window"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syansunyang-collab/pi-context-prune.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/syansunyang-collab/pi-context-prune/issues"
  },
  "homepage": "https://github.com/syansunyang-collab/pi-context-prune#readme",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@sinclair/typebox": "^0.34.52",
    "esbuild": "^0.27.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
